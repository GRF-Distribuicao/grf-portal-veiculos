# ---------------------------------------------------------------------------
# Supabase — projeto "GRF - Portal de Veículos" (ref: yxvzbcqtcfgmsptrqsfa)
# ---------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha o SERVICE_ROLE.
# Na Vercel, cadastre as MESMAS chaves em Settings -> Environment Variables.

# Públicas (vão para o bundle do navegador)
VITE_SUPABASE_URL="https://yxvzbcqtcfgmsptrqsfa.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_Qvu8TxwtXZrm3dikedzLlQ_CfVI52cD"

# Mesmas duas, sem prefixo, para o servidor (SSR / server functions)
SUPABASE_URL="https://yxvzbcqtcfgmsptrqsfa.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_Qvu8TxwtXZrm3dikedzLlQ_CfVI52cD"

# SEGREDO — nunca use o prefixo VITE_ nesta chave e nunca comite o .env.
# Pegue em: Supabase -> Project Settings -> API Keys -> service_role / secret
SUPABASE_SERVICE_ROLE_KEY="COLE_AQUI_A_SERVICE_ROLE_KEY"

# ---------------------------------------------------------------------------
# Notificações de aprovação da Área GRF (opcional até configurar o provedor)
# ---------------------------------------------------------------------------
# O fluxo de aprovação funciona mesmo sem estas variáveis; sem elas, apenas o
# envio automático de e-mail aos três responsáveis fica pendente.
RESEND_API_KEY="COLE_AQUI_A_CHAVE_DO_PROVEDOR_DE_EMAIL"
GRF_APPROVAL_EMAIL_FROM="Portal GRF <acessos@SEU_DOMINIO_VERIFICADO>"

# URL pública do portal. Se omitida na Vercel, o sistema tenta usar
# VERCEL_PROJECT_PRODUCTION_URL automaticamente.
PUBLIC_APP_URL="https://grf-portal-veiculos.vercel.app"
